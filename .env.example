# Resend API key for the "Hunting Day" inquiry form (pages/api/inquire.js).
# Server-only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Inbox that receives inquiries. Required — the form fails closed if unset.
INQUIRY_TO_EMAIL=

# Base URL for large media (video) hosted on Cloudflare R2. Falls back to the
# local /public copy if unset. Swap this to a custom domain once one is wired up.
NEXT_PUBLIC_R2_MEDIA_URL=
